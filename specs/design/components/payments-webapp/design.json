{
  "name": "payments-webapp",
  "type": "web-application",
  "version": "0.1.0",
  "language": "TypeScript",
  "buildpack": "docker",
  "appPath": "payments-webapp",
  "entrypoint": "deployment/web-application",
  "exposure": "internet",
  "stories": [
    1,
    2,
    3,
    4,
    5,
    6,
    7,
    8,
    9,
    13
  ],
  "description": "The signed-in portal for Merchants and Platform Admins: merchant signup, payment-request creation and sharing, transaction history, bank account and payout management, refunds, and an admin-wide view of every merchant's activity. Does not serve the guest checkout page — that is checkout-webapp.",
  "dependencies": [
    {
      "kind": "component",
      "name": "payments-api",
      "wiring": {
        "endpoint": {
          "component": "merchant-payments-african2321-payments-api",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "PAYMENTS_API_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "thunder-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "merchant-payments-c236744c",
        "envBindings": {
          "client_id": "THUNDER_AUTH_CLIENT_ID",
          "issuer": "THUNDER_AUTH_ISSUER",
          "jwks_url": "THUNDER_AUTH_JWKS_URL",
          "resource": "THUNDER_AUTH_RESOURCE",
          "scopes": "THUNDER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "wireframes",
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}
